{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentland",
  "version": "0.3.1",
  "identifier": "dev.agentland.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Agentland",
        "width": 1480,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Agentland",
    "category": "DeveloperTool",
    "shortDescription": "A crew of coding agents, one worktree each",
    "longDescription": "Agentland runs a named crew of CLI coding agents in parallel across real git worktrees, each with its own branch, dev server and preview.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {}
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQTc1QkQ3RkM3M0QyODYKUldTRzBuUDgxMXVuR3UwbWZBcWhoajdnUS93cGlXZFVnSUFkTCs2OGgvbCtpK1M5TnducUI4RU4K",
      "endpoints": [
        "https://github.com/corevider/agentland/releases/latest/download/latest.json"
      ]
    }
  }
}
