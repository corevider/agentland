#!/usr/bin/env python3
"""Read a recording back, on this machine and nowhere else.

Takes a wav path, prints what was said. The model stays loaded in a small
process of its own: loading it costs about eight seconds and dictation that
waits eight seconds for every sentence is dictation nobody uses. That process
lets itself go after half an hour of silence.
"""
import os
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~/.local/share/agentland-voice")
SOCKET = os.path.join(HOME, "warm.sock")
MODEL = os.environ.get("AGENTLAND_WHISPER_MODEL", "small")
# Which language to hear, sent with every recording rather than read once at
# startup: it is picked in Settings, and a process that read it when it began
# would go on hearing the old one until somebody restarted it.
# `AGENTLAND_VOICE_LANGUAGE` is what Agentland sets; the older name still works
# for anybody who put it in front of the command themselves. Unset, or `auto`,
# the model works out which language it is hearing — which is what somebody who
# speaks two of them wants, at the cost of reading the recording twice.
LANGUAGE = os.environ.get("AGENTLAND_VOICE_LANGUAGE") or os.environ.get("AGENTLAND_WHISPER_LANGUAGE")
MODELS = os.path.join(HOME, "models")
IDLE_SECONDS = 30 * 60


def named(language):
    """The language to hear, or None where it is to be guessed."""
    held = (language or "").strip().lower()

    return None if held in ("", "auto") else held


def warm_up(held) -> None:
    import wave

    quiet = os.path.join(HOME, "warm-up.wav")
    with wave.open(quiet, "wb") as file:
        file.setnchannels(1)
        file.setsampwidth(2)
        file.setframerate(16000)
        file.writeframes(b"\x00\x00" * 16000)

    parts, _ = held.transcribe(quiet, vad_filter=True, beam_size=1, language=named(LANGUAGE))
    for _ in parts:
        pass


def threads() -> int:
    """How many threads to hand the model.

    Not `os.cpu_count()`, which counts hyperthreads: on a four-core i7-7700 the
    same sentence took 4.05 seconds on eight threads and 3.21 on four. Two
    threads fighting over one core's arithmetic is one thread's worth of work
    and two threads' worth of waiting, and this machine has a crew running on it
    besides.
    """
    named = os.environ.get("AGENTLAND_WHISPER_THREADS", "").strip()
    if named.isdigit() and int(named) > 0:
        return int(named)

    cores = set()
    root = "/sys/devices/system/cpu"
    try:
        for entry in os.listdir(root):
            topology = os.path.join(root, entry, "topology")
            try:
                with open(os.path.join(topology, "core_id")) as file:
                    core = file.read().strip()
                with open(os.path.join(topology, "physical_package_id")) as file:
                    package = file.read().strip()
            except OSError:
                continue
            cores.add((package, core))
    except OSError:
        pass

    if cores:
        return len(cores)

    return max(1, (os.cpu_count() or 4) // 2)


def serve() -> int:
    from faster_whisper import WhisperModel

    if os.path.exists(SOCKET):
        os.unlink(SOCKET)

    # A thread per core, and greedy decoding: dictation is a sentence at a time,
    # and a beam search over five candidates costs five times the work to pick
    # the same words.
    held = WhisperModel(
        MODEL,
        device="cpu",
        compute_type="int8",
        download_root=MODELS,
        cpu_threads=threads(),
    )

    # Everything lazy is loaded now rather than on somebody's first sentence:
    # the voice model, the one that finds speech in silence, and the audio
    # decoder each cost their own second the first time they are asked.
    warm_up(held)

    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(SOCKET)
    listener.listen(4)
    listener.settimeout(IDLE_SECONDS)

    while True:
        try:
            client, _ = listener.accept()
        except socket.timeout:
            break

        with client:
            # "<language>\t<path>", from a client that may have been handed a
            # different language than the one this process started with.
            asked = client.recv(4096).decode("utf8").strip()
            language, _, wanted = asked.rpartition("\t")
            said = ""

            if wanted and os.path.exists(wanted):
                parts, _ = held.transcribe(
                    wanted,
                    vad_filter=True,
                    beam_size=1,
                    condition_on_previous_text=False,
                    language=named(language or LANGUAGE),
                    # A guess made from one half-second of a short sentence is a
                    # coin toss: listen to more of it, and take the guess only
                    # when the model is reasonably sure.
                    language_detection_segments=2,
                    language_detection_threshold=0.4,
                )
                said = " ".join(part.text.strip() for part in parts).strip()

            client.sendall((said + "\n").encode("utf8"))

    os.unlink(SOCKET)
    return 0


def ask(wav: str) -> str | None:
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(120)
        client.connect(SOCKET)
    except OSError:
        return None

    with client:
        client.sendall(f"{named(LANGUAGE) or 'auto'}\t{wav}".encode("utf8") + b"\n")
        return client.recv(65536).decode("utf8").strip()


def main() -> int:
    if "--serve" in sys.argv:
        return serve()

    if len(sys.argv) < 2:
        print("usage: agentland-transcribe <file.wav>", file=sys.stderr)
        return 2

    wav = sys.argv[1]
    said = ask(wav)

    if said is None:
        os.makedirs(HOME, exist_ok=True)

        # One at a time: two recordings that end together used to start two of
        # these, and each holds the model in memory.
        lock = os.path.join(HOME, "starting.lock")
        try:
            held = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.close(held)
        except FileExistsError:
            if time.time() - os.path.getmtime(lock) > 120:
                os.unlink(lock)
            else:
                for _ in range(120):
                    time.sleep(0.5)
                    said = ask(wav)
                    if said is not None:
                        return print_said(said)

        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--serve"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

        for _ in range(120):
            time.sleep(0.5)
            said = ask(wav)
            if said is not None:
                break

        lock = os.path.join(HOME, "starting.lock")
        if os.path.exists(lock):
            os.unlink(lock)

    return print_said(said or "")


def print_said(said: str) -> int:
    if said:
        print(said)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
